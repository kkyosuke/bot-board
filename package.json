{
  "name": "bot-board",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "bun check",
    "check:guardrails": "bun run scripts/check-guardrails.ts",
    "dev": "vite",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "bun lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "vite preview",
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "verify": "bun fmt --check && bun lint && bun check && bun run check:guardrails && bun test && bun run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "bun": ">=1.4.6-0"
  }
}
